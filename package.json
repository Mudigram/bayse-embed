{
  "name": "bayse-markets-embed",
  "version": "0.1.0",
  "description": "Embeddable market widgets for Bayse Markets",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:embed": "vite build --config vite.embed.config.ts",
    "type-check": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": "^18",
    "react-dom": "^18"
  },
  "devDependencies": {
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@vitejs/plugin-react": "^4",
    "typescript": "^5",
    "vite": "^5",
    "vite-plugin-dts": "^3"
  },
  "dependencies": {
    "bayse-markets-sdk": "^0.1.1"
  }
}